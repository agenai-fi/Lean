# AlphaSeek Custom Lean Container
# Build Lean from source with custom Parquet data reader and Apache.Arrow

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build

# Install git
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

# Clone Lean repository (use local files if building from submodule)
WORKDIR /src
COPY . /src/Lean

# Parquet.Net is already referenced in QuantConnect.csproj
# Publish will copy all dependencies including NuGet packages

# Publish Launcher project to /opt/lean (includes all dependencies)
# Exclude conflicting config files
WORKDIR /src/Lean
RUN dotnet publish Launcher/QuantConnect.Lean.Launcher.csproj \
    --configuration Release \
    --output /opt/lean \
    /p:PublishSingleFile=false \
    /p:ErrorOnDuplicatePublishOutputFiles=false

# Runtime stage - use quantconnect/lean as base for Python dependencies
FROM quantconnect/lean:latest

# Copy published Lean binaries from build stage (includes all DLLs)
COPY --from=build /opt/lean /Lean/Launcher/bin/Release

# Install FastAPI dependencies
RUN pip install --no-cache-dir \
    fastapi==0.115.0 \
    uvicorn[standard]==0.32.0 \
    pydantic==2.5.0

# Copy FastAPI server
COPY server.py /app/server.py

# Create workspace directories
RUN mkdir -p /app/strategies /app/data/market

# Set working directory
WORKDIR /app

# Expose FastAPI port
EXPOSE 8001

# Override base image ENTRYPOINT and run FastAPI server
ENTRYPOINT []
CMD ["python", "/app/server.py"]
